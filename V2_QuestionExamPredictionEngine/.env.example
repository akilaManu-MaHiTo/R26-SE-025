MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=dbms_analytics
PASS_THRESHOLD=0.5
MIN_STUDENTS=10
MIN_ATTEMPTS=2
ALGORITHM_VERSION=analytics-v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT=120
OLLAMA_CLASSIFY_TEMPERATURE=0.2
OLLAMA_GENERATE_TEMPERATURE=0.8
# Set when calling a remote Ollama (e.g. Colab tunnel). Leave empty for local.
OLLAMA_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_AVAILABLE=true
CANDIDATE_SIMILARITY_THRESHOLD=0.85