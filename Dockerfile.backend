FROM python:3.11-slim

# Install OS-level dependencies for OpenCV, audio processing, and build essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install
COPY Gradex_AI_Server/app/requirements.txt /app/server_requirements.txt
RUN pip install --no-cache-dir -r /app/server_requirements.txt

# Copy application source code
COPY . /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV GRADEX_API_KEY=dev-secret-key-12345
ENV PORT=8000

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "Gradex_AI_Server.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
