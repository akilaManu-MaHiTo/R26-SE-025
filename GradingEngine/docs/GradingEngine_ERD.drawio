        <!-- Legend -->
        <mxCell id="legend" value="Legend&#xa;• Solid FK arrow = real Mongo ObjectId reference&#xa;• Dashed / logical = match by course code string (no FK)&#xa;• evaluation is embedded JSON inside submissions (not a collection)&#xa;• Chroma + disk are separate stores outside MongoDB&#xa;• View results later: GET /submissions?rubric_id=..." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#F9FAFB;strokeColor=#9CA3AF;fontColor=#374151;fontSize=12;" vertex="1" parent="1">
