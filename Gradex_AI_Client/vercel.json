{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://57.159.25.221:8000/api/:path*"
    },
    {
      "source": "/courses/:path*",
      "destination": "http://57.159.25.221:8000/courses/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
