# Gradex AI Server. Copy this file to Gradex_AI_Server/app/.env and fill it in.
# Never commit real keys. VivaEvaluationEngine reads this same file too (after its own .env),
# so the keys below also work for the viva scoring engine.

# ---------------------------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------------------------
MONGODB_URL=
# Viva data lives in this database:
#   viva_sessions         the vivas created in the Viva Workspace
#   viva_analysis_results every analysed recording / published mark
#   viva_subject_rubrics  the subject concepts a technical viva is scored against
# DATABASE_NAME here wins over the one in ../GradingEngine/.env. If it is not set anywhere the
# server uses "Grading". If auth fails, MONGODB_URL falls back to ../GradingEngine/.env.
DATABASE_NAME=Grading

# Exam keys use the server MONGODB_URL and this database.
EXAM_KEYS_DATABASE_NAME=gradev5

# ---------------------------------------------------------------------------------------------
# Login sessions (required)
# ---------------------------------------------------------------------------------------------
# Cookie sessions; false is for local HTTP development only. Use true with HTTPS.
AUTH_COOKIE_SECURE=false
# Web client origins allowed to call the API. Add the deployed client URL in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Accounts/sessions use AdaptiveExamAnalyticsEngine/.env MongoDB settings.
# Create/reset accounts with: python -m Gradex_AI_Server.scripts.provision_user
# Client: point it at this server with VITE_BACKEND_URL (see Gradex_AI_Client/.env.example).

# ---------------------------------------------------------------------------------------------
# LLM providers (set at least one key)
# ---------------------------------------------------------------------------------------------
# Used by: the delivery/clarity judge, Q&A relevance, technical-accuracy concept scoring and the
# live copilot. Chain: Groq -> Gemini -> OpenRouter. Without a key those steps are skipped and
# the technical-accuracy panel shows as unavailable.
AI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional alternatives the viva engine also accepts: VIVA_LLM_API_KEY, BACKUP_API_KEY
# Prefer a live Groq chat id. Dead names 404 and the copilot auto-falls through.
VIVA_LLM_MODEL=openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b
VIVA_COPILOT_LLM_MODEL=openai/gpt-oss-20b
# Optional: override Gemini / OpenRouter model defaults
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Optional: use another OpenAI-compatible endpoint instead of Groq
# (first one set wins: OPENAI_BASE_URL, LLM_BASE_URL, VIVA_LLM_BASE_URL)
# VIVA_LLM_BASE_URL=https://api.groq.com/openai/v1
# The live copilot's chat providers can also be pointed elsewhere (a proxy or gateway). Defaults are
# the public APIs. Groq uses VIVA_COPILOT_LLM_BASE_URL first, then the chain above.
# VIVA_COPILOT_LLM_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=https://gradex.local

# ---------------------------------------------------------------------------------------------
# Speech to text
# ---------------------------------------------------------------------------------------------
# Live copilot transcription (Groq).
VIVA_COPILOT_STT_MODEL=whisper-large-v3-turbo
# Optional: another speech-to-text endpoint, and the minimum seconds between STT requests.
# VIVA_COPILOT_STT_BASE_URL=
# VIVA_COPILOT_MIN_STT_GAP=0.4
# Uploaded-recording analysis (local OpenAI Whisper). small=CPU default; medium is slow on CPU.
# Options: tiny, base, small, medium, large, large-v2, large-v3, turbo
VIVA_WHISPER_MODEL=small
# Set to 1 to free memory after every analysis (slower next request).
# VIVA_WHISPER_RELEASE_AFTER=1

# ---------------------------------------------------------------------------------------------
# Viva marking
# ---------------------------------------------------------------------------------------------
# Each viva is marked out of the "Total marks" (1-100) its lecturer enters in the Viva Workspace;
# the technical score uses the same total. For technical vivas the lecturer also sets the
# technical share of the final mark there (20-90%, default 50%; the AI part is the rest).
# Neither is an environment setting.
# VIVA_MARK_MAX (default 20) only applies to a viva created without a total. Letter grades are
# percentages of the full mark, so they follow any total (90% = A+). A mark keeps the total it was
# analysed with. Restart the server after changing these.
# VIVA_MARK_MAX=20
# VIVA_MARK_DECIMALS=2
# Technical vivas: smallest share of the subject's concept weight the answer must touch.
# Below it the recording is held for review with no mark (wrong topic / wrong subject).
# A fraction from 0 to 1; 0.05 = 5%.
VIVA_MIN_TOPIC_COVERAGE=0.05

# ---------------------------------------------------------------------------------------------
# Upload and analysis limits
# ---------------------------------------------------------------------------------------------
# Before analysis every video passes a fixed check (2 MB - 1 GB, 10 s - 30 min, readable, not too
# blurry/dark/noisy). Those limits are in app/viva_video_validation.py, not here.
# Blocking analyze ceiling (seconds). Client XHR timeout is 600000 ms.
VIVA_ANALYZE_TIMEOUT_SECONDS=600
# Copilot in-memory sessions expire after idle TTL (seconds). 14400 = 4 h idle. 0 = disable.
VIVA_COPILOT_SESSION_TTL_SECONDS=14400
# Recordings are deleted after analysis. Set to 1 to keep live-copilot recordings for debugging.
# VIVA_KEEP_UPLOADS=1
