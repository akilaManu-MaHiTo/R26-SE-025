MONGODB_URL=
# Viva marks live in this database (collection: marks). If auth fails here, the server
# falls back to MONGODB_URL from ../GradingEngine/.env when that file exists.
DATABASE_NAME=vivamark

# Shared gate for /api/viva-analyze, /api/viva-marks, /api/viva-copilot
GRADEX_API_KEY=
# Client: VITE_GRADEX_API_KEY must match (Gradex_AI_Client/.env.local)

AI_API_KEY=
GROQ_API_KEY=
# Prefer a live Groq chat id. Dead names 404 and the judge used to stay on formula fallback.
VIVA_LLM_MODEL=openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b
VIVA_COPILOT_LLM_MODEL=openai/gpt-oss-20b
VIVA_COPILOT_STT_MODEL=whisper-large-v3-turbo
# Viva analyze pipeline (local OpenAI Whisper). medium=default balance; large-v3=best (slower, ~5GB RAM).
# Options: tiny, base, small, medium, large, large-v2, large-v3, turbo
VIVA_WHISPER_MODEL=medium
# Copilot in-memory sessions expire after idle TTL (seconds). 14400 = 4 h idle. 0 = disable.
VIVA_COPILOT_SESSION_TTL_SECONDS=14400
# Blocking analyze ceiling (seconds). Client XHR timeout is 600000 ms.
VIVA_ANALYZE_TIMEOUT_SECONDS=600
