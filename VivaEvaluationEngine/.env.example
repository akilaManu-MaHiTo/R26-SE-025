# Copy to VivaEvaluationEngine/.env and fill in. Never commit real keys.
# The engine loads this file first, then Gradex_AI_Server/app/.env, and the first value found wins.
# When the engine runs inside Gradex_AI_Server you can keep all settings in the server .env
# (see Gradex_AI_Server/app/.env.example) and leave this file empty.

# LLM key for the delivery/clarity judge, Q&A relevance and technical-accuracy scoring.
# One of these is enough (first set wins): VIVA_LLM_API_KEY, GROQ_API_KEY, AI_API_KEY, BACKUP_API_KEY
AI_API_KEY=
GROQ_API_KEY=
# Q&A relevance uses the same Groq key/model as the delivery judge.
# One request per detected panel question (max 40). No extra key required.
# Optional: another OpenAI-compatible endpoint (default https://api.groq.com/openai/v1).
# VIVA_LLM_BASE_URL=

# Technical vivas: smallest share (0-1) of the subject's concept weight an answer must touch;
# below it the recording is held for review with no mark. 0.05 = 5%.
# VIVA_MIN_TOPIC_COVERAGE=0.05

# Marking scale. Normally each viva sets its own "Total marks" in the Viva Workspace;
# VIVA_MARK_MAX (default 20) is only the fallback for a viva without one.
# VIVA_MARK_MAX=20
# VIVA_TECHNICAL_MAX=20
# VIVA_MARK_DECIMALS=2

# Speech recognition for uploaded recordings (local OpenAI Whisper). small=CPU default.
# Options: tiny, base, small, medium, large, large-v2, large-v3, turbo
# VIVA_WHISPER_MODEL=small
# Set to 1 to free memory after every analysis.
# VIVA_WHISPER_RELEASE_AFTER=1

# Speech emotion recognition (local)
# huggingface (default) | speechbrain | heuristic
VIVA_SER_BACKEND=huggingface
VIVA_SER_MODEL=superb/wav2vec2-base-superb-er
# VIVA_SER_SPEECHBRAIN_SOURCE=speechbrain/emotion-recognition-wav2vec2-IEMOCAP

# Lip-movement check: one mouth-movement event is expected per this many spoken words.
# VIVA_LIP_WORDS_PER_EVENT=25

# Speaker split (student vs lecturer). Default mfcc_kmeans is offline and scores
# only the assigned student track. Set off to restore mixed-audio scoring.
# VIVA_DIARIZATION_BACKEND=mfcc_kmeans
# VIVA_DIARIZATION_BACKEND=pyannote
# VIVA_DIARIZATION_BACKEND=off
# VIVA_STUDENT_SPEAKER=SPEAKER_00
# Speakers the splitter looks for (2-6, default 4).
# VIVA_MAX_SPEAKERS=4
# pyannote only: a Hugging Face token (HUGGINGFACE_TOKEN, HF_TOKEN or HUGGING_FACE_HUB_TOKEN)
# and the pipeline to load.
# HUGGINGFACE_TOKEN=
# VIVA_PYANNOTE_PIPELINE=pyannote/speaker-diarization-3.1
