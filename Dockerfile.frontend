# Stage 1: Build Vite React application
FROM node:20-alpine AS builder

WORKDIR /app

COPY Gradex_AI_Client/package.json ./
RUN npm install

COPY Gradex_AI_Client/ ./
ARG VITE_BACKEND_URL=http://localhost:8000
ARG VITE_GRADEX_API_KEY=dev-secret-key-12345
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_GRADEX_API_KEY=$VITE_GRADEX_API_KEY

RUN npm run build

# Stage 2: Serve using Nginx
FROM nginx:alpine

COPY Gradex_AI_Client/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

